rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isValidPeticionCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly(['numero', 'nombre', 'texto', 'estado', 'fechaCreacion', 'telefono', 'correo'])
        && d.keys().hasAll(['numero', 'nombre', 'texto', 'estado', 'fechaCreacion'])
        && d.estado == 'pendiente'
        && d.numero is int && d.numero > 0
        && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 80
        && d.texto is string && d.texto.size() > 0 && d.texto.size() <= 8000
        && d.fechaCreacion == request.time
        && (!('telefono' in d) || (d.telefono is string && d.telefono.size() <= 40))
        && (!('correo' in d) || (d.correo is string && d.correo.size() <= 120));
    }

    match /peticiones/{id} {
      allow read: if true;
      allow create: if isValidPeticionCreate();
      allow update, delete: if isAdmin();
    }

    function isValidAvisoCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly(['titulo', 'descripcion', 'importante', 'fecha', 'fechaFin', 'bannerUrl', 'fechaCreacion'])
        && d.keys().hasAll(['titulo', 'descripcion', 'importante', 'fechaCreacion'])
        && d.titulo is string && d.titulo.size() > 0 && d.titulo.size() <= 80
        && d.descripcion is string && d.descripcion.size() <= 300
        && (d.descripcion.size() > 0 || ('bannerUrl' in d && d.bannerUrl.size() > 0))
        && d.importante is bool
        && d.fechaCreacion == request.time
        && (!('fecha' in d) || d.fecha is timestamp)
        && (!('fechaFin' in d) || (d.fechaFin is timestamp && 'fecha' in d))
        && (!('bannerUrl' in d) || (d.bannerUrl is string && d.bannerUrl.size() > 0
            && d.bannerUrl.size() <= 500 && d.bannerUrl.matches('^https?://.*')));
    }

    match /avisos/{id} {
      allow read: if true;
      allow create: if isAdmin() && isValidAvisoCreate();
      allow update, delete: if isAdmin();
    }

    function isValidCitaCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly(['texto', 'referencia', 'version', 'fechaCreacion'])
        && d.keys().hasAll(['texto', 'referencia', 'version', 'fechaCreacion'])
        && d.texto is string && d.texto.size() > 0 && d.texto.size() <= 2000
        && d.referencia is string && d.referencia.size() > 0 && d.referencia.size() <= 80
        && d.version in ['RVR1960', 'NVI', 'LBLA', 'NTV', 'DHH', 'RVC']
        && d.fechaCreacion == request.time;
    }

    match /citas/{id} {
      allow read: if true;
      allow create: if isAdmin() && isValidCitaCreate();
      allow update, delete: if isAdmin();
    }

    match /metadata/counters {
      allow get: if true;
      allow update: if isAdmin()
        || (request.resource.data.keys().hasOnly(['peticionesCount'])
            && request.resource.data.peticionesCount == resource.data.peticionesCount + 1);
      allow create, delete: if isAdmin();
    }

    match /rateLimits/{key} {
      allow read, write: if false;
    }
  }
}
